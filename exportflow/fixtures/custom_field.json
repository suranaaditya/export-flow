[
 {
  "doctype": "Custom Field",
  "name": "Customer-export_details_section",
  "dt": "Customer",
  "fieldname": "export_details_section",
  "fieldtype": "Section Break",
  "label": "Export Details",
  "insert_after": "language",
  "collapsible": 1,
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-default_incoterm",
  "dt": "Customer",
  "fieldname": "default_incoterm",
  "fieldtype": "Link",
  "label": "Default Incoterm",
  "options": "Incoterm",
  "insert_after": "export_details_section",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-cb_exportflow_customer",
  "dt": "Customer",
  "fieldname": "cb_exportflow_customer",
  "fieldtype": "Column Break",
  "insert_after": "default_incoterm",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Customer-destination_country",
  "dt": "Customer",
  "fieldname": "destination_country",
  "fieldtype": "Link",
  "label": "Destination Country",
  "options": "Country",
  "insert_after": "cb_exportflow_customer",
  "description": "Default destination country — drives country-specific document checklist rules",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Supplier-default_merchant_export_scheme",
  "dt": "Supplier",
  "fieldname": "default_merchant_export_scheme",
  "fieldtype": "Check",
  "label": "Default Merchant Export Scheme (0.1% GST)",
  "insert_after": "is_transporter",
  "description": "Usually supplies under the 0.1% concessional GST notification for merchant exports",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-pharma_details_section",
  "dt": "Item",
  "fieldname": "pharma_details_section",
  "fieldtype": "Section Break",
  "label": "Pharma Export Details",
  "insert_after": "description",
  "collapsible": 1,
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-pharmacopoeia_grade",
  "dt": "Item",
  "fieldname": "pharmacopoeia_grade",
  "fieldtype": "Select",
  "label": "Pharmacopoeia Grade",
  "options": "\nIP\nBP\nUSP\nEP\nJP\nPh. Int.\nOther",
  "insert_after": "pharma_details_section",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-cas_number",
  "dt": "Item",
  "fieldname": "cas_number",
  "fieldtype": "Data",
  "label": "CAS Number",
  "insert_after": "pharmacopoeia_grade",
  "description": "Chemical Abstracts Service registry number (optional)",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-cb_exportflow_item",
  "dt": "Item",
  "fieldname": "cb_exportflow_item",
  "fieldtype": "Column Break",
  "insert_after": "cas_number",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Item-default_pack_size",
  "dt": "Item",
  "fieldname": "default_pack_size",
  "fieldtype": "Data",
  "label": "Default Pack Size",
  "insert_after": "cb_exportflow_item",
  "description": "e.g. 25 kg HDPE drum",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Sales Order-payment_terms_narrative",
  "dt": "Sales Order",
  "fieldname": "payment_terms_narrative",
  "fieldtype": "Small Text",
  "label": "Payment Terms Narrative",
  "insert_after": "named_place",
  "description": "Negotiated payment stages as agreed in the deal, e.g. 30% advance, 70% against B/L copy",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-merchant_export_section",
  "dt": "Purchase Order",
  "fieldname": "merchant_export_section",
  "fieldtype": "Section Break",
  "label": "Merchant Export · GST",
  "insert_after": "customer_contact_email",
  "collapsible": 1,
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-merchant_export_scheme",
  "dt": "Purchase Order",
  "fieldname": "merchant_export_scheme",
  "fieldtype": "Check",
  "label": "Merchant Export Scheme (0.1% GST)",
  "insert_after": "merchant_export_section",
  "allow_on_submit": 1,
  "description": "Procured under the 0.1% concessional GST notification — goods must be exported within 90 days of the supplier invoice. Defaults from the supplier on new orders.",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-supplier_invoice_no",
  "dt": "Purchase Order",
  "fieldname": "supplier_invoice_no",
  "fieldtype": "Data",
  "label": "Supplier Invoice No",
  "insert_after": "merchant_export_scheme",
  "allow_on_submit": 1,
  "no_copy": 1,
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-supplier_invoice_date",
  "dt": "Purchase Order",
  "fieldname": "supplier_invoice_date",
  "fieldtype": "Date",
  "label": "Supplier Invoice Date",
  "insert_after": "supplier_invoice_no",
  "allow_on_submit": 1,
  "no_copy": 1,
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-cb_exportflow_po",
  "dt": "Purchase Order",
  "fieldname": "cb_exportflow_po",
  "fieldtype": "Column Break",
  "insert_after": "supplier_invoice_date",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Payment Entry-pro_forma_invoice",
  "dt": "Payment Entry",
  "fieldname": "pro_forma_invoice",
  "fieldtype": "Link",
  "label": "Pro Forma Invoice",
  "options": "Pro Forma Invoice",
  "insert_after": "reference_date",
  "depends_on": "eval:doc.payment_type=='Receive'",
  "description": "The pro forma invoice this incoming payment settles — updates its status",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-gst_export_deadline",
  "dt": "Purchase Order",
  "fieldname": "gst_export_deadline",
  "fieldtype": "Date",
  "label": "GST Export Deadline",
  "insert_after": "cb_exportflow_po",
  "read_only": 1,
  "allow_on_submit": 1,
  "no_copy": 1,
  "description": "Supplier invoice date + 90 days — the shipment must be exported (shipped on board / departed) by this date",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-merchanting_trade",
  "dt": "Purchase Order",
  "fieldname": "merchanting_trade",
  "fieldtype": "Check",
  "label": "Third-country / merchanting trade",
  "insert_after": "gst_export_deadline",
  "description": "Goods bought overseas and shipped directly to a foreign buyer without entering India (FEMA merchanting). GST is nil; must be linked to the export sales order.",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-grn_auto_closed",
  "dt": "Purchase Order",
  "fieldname": "grn_auto_closed",
  "fieldtype": "Check",
  "label": "Closed by goods receipt",
  "insert_after": "merchanting_trade",
  "hidden": 1,
  "read_only": 1,
  "no_copy": 1,
  "print_hide": 1,
  "description": "System flag: this Purchase Order was auto-Closed because its goods were fully received (Goods Receipt Note). Cleared when a cancel/return re-opens it, or when an operator re-opens it by hand. Used as Close-provenance so goods-receipt never re-opens a PO an operator deliberately Closed.",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order-payment_terms_narrative",
  "dt": "Purchase Order",
  "fieldname": "payment_terms_narrative",
  "fieldtype": "Small Text",
  "label": "Payment Terms Narrative",
  "insert_after": "terms",
  "description": "Payment terms agreed with the supplier, e.g. 30% advance, balance against goods receipt.",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order Item-specification",
  "dt": "Purchase Order Item",
  "fieldname": "specification",
  "fieldtype": "Small Text",
  "label": "Specification",
  "insert_after": "description",
  "description": "Per-line product specification (grade, purity, particle size, pharmacopoeia, etc.) — printed on the purchase order.",
  "module": "ExportFlow"
 },
 {
  "doctype": "Custom Field",
  "name": "Purchase Order Item-packaging",
  "dt": "Purchase Order Item",
  "fieldname": "packaging",
  "fieldtype": "Small Text",
  "label": "Packaging Required",
  "insert_after": "specification",
  "description": "Per-line packaging requirement (e.g. 25 kg HDPE drums, double LDPE liner) — printed on the purchase order.",
  "module": "ExportFlow"
 }
]
